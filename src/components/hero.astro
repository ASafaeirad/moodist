---
import { Container } from './container';
---

<div class="hero">
  <Container>
    <div class="wrapper">
      <div class="pattern"></div>
      <div class="logo-wrapper">
        <img
          alt="Faded Moodist Logo"
          aria-hidden="true"
          class="logo"
          height={48}
          src="/logo.svg"
          width={48}
        />
      </div>

      <h1 class="title">Ambient Sounds</h1>
    </div>
  </Container>
</div>

<style>
  .hero {
    text-align: center;

    .wrapper {
      position: relative;
      padding: 40px 0 40px;
    }

    & .logo-wrapper {
      mask-image: linear-gradient(#000, rgb(0 0 0 / 40%), rgb(0 0 0 / 5%));

      & .logo {
        display: block;
        width: 48px;
        margin: 0 auto 20px;
        opacity: 1;
        animation-name: logo;
        animation-duration: 60s;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
      }
    }
  }

  @keyframes logo {
    0% {
      transform: rotate(0);
    }

    100% {
      transform: rotate(360deg);
    }
  }
</style>
